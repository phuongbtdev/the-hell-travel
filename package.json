{
  "name": "am-phu-3d",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "assets:characters": "node scripts/build-character-assets.mjs",
    "assets:videos": "node --import tsx scripts/render-floor-videos.ts",
    "assets:music": "python3 scripts/build-soundtrack.py",
    "verify:assets": "node --import tsx scripts/verify-assets.ts",
    "verify:experience": "node --import tsx scripts/verify-experience.ts",
    "verify:chaos": "node --import tsx scripts/verify-chaos.ts",
    "assets:experience-previews": "node --import tsx scripts/render-experience-previews.ts",
    "assets:chaos-previews": "node --import tsx scripts/render-chaos-previews.ts",
    "dev": "concurrently -k \"npm:dev:web\" \"npm:dev:server\"",
    "dev:web": "vite --host 0.0.0.0",
    "dev:server": "tsx watch server/src/index.ts",
    "build": "tsc -b && vite build",
    "start:server": "tsx server/src/index.ts"
  },
  "dependencies": {
    "@colyseus/sdk": "^0.18.0",
    "@colyseus/schema": "^5.0.0",
    "@colyseus/ws-transport": "^0.18.0",
    "colyseus": "^0.18.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/three": "^0.180.0",
    "concurrently": "^9.0.0",
    "tsx": "^4.0.0",
    "typescript": "~5.8.0",
    "vite": "^6.0.0"
  }
}
